# ---- Database ----
POSTGRES_DB=socialmedia
POSTGRES_USER=collector
POSTGRES_PASSWORD=change_me_strong_password

# ---- Pseudonymisation (NEVER commit the real value) ----
HMAC_SECRET=change_me_64_random_hex_chars
KEEP_REID_TABLE=false

# ---- Collection window ----
DATE_FROM=2023-01-01
DATE_TO=today
LANGS=en,fr
PILOT_MODE=true
CONTACT_EMAIL=you@university.edu

# ---- Bluesky (app password: Settings > App passwords) ----
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# ---- Reddit (https://www.reddit.com/prefs/apps, type "script") ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ARCHIVE_DIR=/app/data/reddit_dumps

# ---- Mastodon (public API, no token) ----
MASTODON_INSTANCES=mastodon.social,fosstodon.org

# ---- Optional (free key) / official researcher access only (auto-disabled if empty) ----
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
META_CONTENT_LIBRARY_TOKEN=
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=

# ---- Local LLM "brain" (Ollama in Docker, GPU) — drives discovery, relevance and annotation ----
OLLAMA_MODEL=qwen3:14b
USE_LLM=true
# ---- Telegram public channels (t.me/s/<channel>, no account) ----
ENABLE_TELEGRAM_WEB=true
# ---- Limits ----
MAX_USERS_HOP1=2000
MAX_USERS_HOP2=5000
MIN_POSTS_PER_USER=20
PILOT_MAX_THREADS=2000
# ---- Web dashboard (http://<server>:8080). Optional password, user = admin ----
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=
