# ---- Database ----
POSTGRES_DB=socialmedia
POSTGRES_USER=collector
POSTGRES_PASSWORD=change_me_strong_password

# ---- Pseudonymisation (NEVER commit the real value) ----
HMAC_SECRET=change_me_64_random_hex_chars
KEEP_REID_TABLE=false

# ---- Collection window ----
DATE_FROM=2023-01-01
DATE_TO=today
LANGS=en,fr
PILOT_MODE=true
CONTACT_EMAIL=you@university.edu

# ---- Bluesky (app password: Settings > App passwords) ----
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# ---- Reddit (https://www.reddit.com/prefs/apps, type "script") ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ARCHIVE_DIR=/app/data/reddit_dumps

# ---- Mastodon (public API, no token) ----
MASTODON_INSTANCES=mastodon.social,fosstodon.org

# ---- Lemmy (fediverse Reddit alternative, public API, no key) ----
ENABLE_LEMMY=true
LEMMY_INSTANCE=lemmy.world
# ---- Stack Exchange (free; 300 req/day without key, 10k/day with a free key from stackapps.com) ----
ENABLE_STACKEXCHANGE=true
STACKEXCHANGE_KEY=

# ---- Optional (free key) / official researcher access only (auto-disabled if empty) ----
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
META_CONTENT_LIBRARY_TOKEN=
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=

# ---- Local LLM "brain" (Ollama in Docker, GPU) — drives discovery, relevance and annotation ----
OLLAMA_MODEL=qwen3:14b
USE_LLM=true
# ---- Telegram ----
# Without account: public channel previews t.me/s/<channel> (no keyword search, channels only).
ENABLE_TELEGRAM_WEB=true
# Recommended (free): official API -> keyword search, public groups (real users), comments, full history.
#   1) https://my.telegram.org > API development tools > api_id + api_hash
#   2) docker compose run --rm -it collector python -m collector telegram-login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# ---- Public research datasets (X, Weibo) from Hugging Face / Zenodo, chosen by Qwen ----
#   docker compose run --rm collector python -m collector datasets
DATASETS_AUTO=true
# also possible: reddit, facebook, instagram (e.g. DATASETS_PLATFORMS=x,weibo,reddit,facebook,instagram)
DATASETS_PLATFORMS=x,weibo
DATASETS_MAX_ROWS=200000
DATASETS_MAX_MB=2000
DATASETS_RESPECT_DATES=true
DATASETS_ALLOW_UNKNOWN_LICENSE=false
DATASETS_ALLOW_SCRAPED=false
HF_TOKEN=
# ---- Limits ----
MAX_USERS_HOP1=2000
MAX_USERS_HOP2=5000
MIN_POSTS_PER_USER=20
PILOT_MAX_THREADS=2000
# ---- Web dashboard (http://<server>:8080). Optional password, user = admin ----
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=
# ---- Time balance (same budget every month DATE_FROM..today) ----
DISCOVERY_POSTS_PER_MONTH=
POSTS_PER_USER_MONTH=40
MAX_SCAN_PER_USER=
